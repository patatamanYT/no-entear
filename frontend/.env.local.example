# Base URL of the FastAPI backend (GET /api/match-data, POST /api/upload, POST /api/process, GET /api/health).
NEXT_PUBLIC_API_URL=http://localhost:8000

# When "true", always use the bundled static fixture (src/lib/mockFixture.ts) instead of
# calling the backend — useful for UI development with no backend running at all.
# Leave unset/false in normal use: the app already falls back to the fixture automatically
# if the real API call fails.
NEXT_PUBLIC_USE_FIXTURE=false

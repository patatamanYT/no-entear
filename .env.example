# Clave de la API de Anthropic (nunca la subas al repo ni la expongas al frontend).
ANTHROPIC_API_KEY=

# Modelo usado para las traducciones EN/PT-BR. Ajusta si tu cuenta usa otro id.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Puerto del servidor local.
PORT=4173

# Solo necesario si tu Chromium de Playwright vive en una ruta no estandar
# (normalmente no hace falta: `npx playwright install` deja todo listo).
PLAYWRIGHT_CHROMIUM_PATH=
